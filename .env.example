# ---- REQUIRED ----
# Token mint (contract address) of the coin
TOKEN_MINT=
# RPC URL with getProgramAccounts support (e.g. Helius: https://mainnet.helius-rpc.com/?api-key=XXXX)
RPC_URL=
# Base58 private key of the POT wallet (the wallet that receives the 50% fee share). Keep ONLY fees in it.
POT_PRIVATE_KEY=

# ---- OPTIONAL (defaults shown) ----
TICKER=WHEEL
MIN_TOKENS=250000
MIN_HOLD_MINUTES=5
ROUND_MINUTES=5
# equal = every wallet one slice (original idea) | balance = slice size by holdings (anti wallet-splitting)
WEIGHTING=equal
# Minimum pot before a round pays out; smaller pots roll over to the next round
MIN_POT_SOL=0.01
# SOL kept in the pot wallet for tx fees/rent
RESERVE_SOL=0.005
# Try to claim creator fees into the pot wallet via PumpPortal before each round
CLAIM_FEES=true
# Comma separated wallets that can never win (dev wallet, team, CEX, etc.)
EXCLUDE_WALLETS=
# true = pick winners but do NOT send SOL (for testing)
DRY_RUN=false
